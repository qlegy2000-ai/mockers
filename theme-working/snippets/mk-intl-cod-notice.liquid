{%- comment -%}
  mk-intl-cod-notice.liquid — tells non-Egyptian shoppers that Cash on Delivery
  is not available on their order, immediately above the checkout button.

  WHAT THIS IS NOT: it does not remove COD from checkout. Shopify exposes no
  per-country control over payment methods in the Admin API, and hiding one needs
  a payment-customization Function supplied by an installed app — this store has
  none. Closing COD abroad properly still needs that app rule
  ("hide Cash on Delivery unless country is Egypt").

  WHY IT EXISTS ANYWAY: until that rule is in place an international customer can
  still select COD and the order cannot be honoured. Saying so before checkout is
  cheaper than refunding afterwards.

  Egypt sees nothing — COD is the main payment method there (about 70% of orders)
  and must not be discouraged.

  TO REMOVE: delete this file and the {% raw %}{% render 'mk-intl-cod-notice' %}{% endraw %}
  line in layout/theme.liquid.
{%- endcomment -%}

{%- if localization.country.iso_code != 'EG' -%}
<script>
  (function () {
    var TEXT = 'International orders are card payment only — Cash on Delivery is not available outside Egypt.';

    function add() {
      var btns = document.querySelectorAll('[name="checkout"]');
      for (var i = 0; i < btns.length; i++) {
        var btn = btns[i];
        var host = btn.parentNode;
        if (!host || host.querySelector(':scope > .mk-cod-note')) continue;
        var n = document.createElement('div');
        n.className = 'mk-cod-note';
        n.setAttribute('role', 'note');
        n.textContent = TEXT;
        host.insertBefore(n, btn);
      }
    }

    function ready(fn) {
      if (document.readyState !== 'loading') fn();
      else document.addEventListener('DOMContentLoaded', fn);
    }

    ready(function () {
      add();
      // the cart drawer is rendered on demand and re-rendered on every change
      var t;
      new MutationObserver(function () {
        clearTimeout(t);
        t = setTimeout(add, 120);
      }).observe(document.body, {childList: true, subtree: true});
    });
  })();
</script>
<style>
  .mk-cod-note {
    margin: 0 0 10px;
    padding: 8px 11px;
    border-inline-start: 3px solid #d18a2e;
    background: #fdf5ec;
    color: #6b4a1c;
    border-radius: 5px;
    font-size: 12px;
    line-height: 1.45;
  }
</style>
{%- endif -%}
