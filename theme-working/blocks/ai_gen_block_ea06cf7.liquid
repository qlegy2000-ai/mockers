{% doc %}
  @prompt
    i want to add stoe thik liste sotre notice for the clients and to grap there attion 
    this is the message 
    All sale items are final — no returns or exchanges, because amazing deals don’t come with a rewind button.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-store-notice-{{ ai_gen_id }} {
    position: relative;
    background: linear-gradient(135deg, {{ block.settings.background_color }} 0%, {{ block.settings.background_color | color_darken: 10 }} 100%);
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    text-align: {{ block.settings.text_alignment }};
    border-radius: {{ block.settings.border_radius }}px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    margin: {{ block.settings.margin_top }}px auto {{ block.settings.margin_bottom }}px;
    max-width: 100%;
  }

  .ai-store-notice-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
    animation: ai-store-notice-shine-{{ ai_gen_id }} {{ block.settings.animation_duration }}s ease-in-out infinite;
    animation-delay: {{ block.settings.animation_delay }}s;
  }

  @keyframes ai-store-notice-shine-{{ ai_gen_id }} {
    0% {
      left: -100%;
    }
    100% {
      left: 100%;
    }
  }

  .ai-store-notice-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    {% if block.settings.text_alignment == 'center' %}
      justify-content: center;
    {% elsif block.settings.text_alignment == 'right' %}
      justify-content: flex-end;
    {% else %}
      justify-content: flex-start;
    {% endif %}
    gap: 15px;
    flex-wrap: wrap;
  }

  .ai-store-notice-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    color: {{ block.settings.icon_color }};
    animation: ai-store-notice-pulse-{{ ai_gen_id }} 2s ease-in-out infinite;
  }

  @keyframes ai-store-notice-pulse-{{ ai_gen_id }} {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.1);
    }
  }

  .ai-store-notice-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    line-height: 1.4;
    margin: 0;
    flex: 1;
    min-width: 200px;
  }

  .ai-store-notice-text-{{ ai_gen_id }} strong {
    color: {{ block.settings.highlight_color }};
    font-weight: 700;
  }

  .ai-store-notice-close-{{ ai_gen_id }} {
    position: absolute;
    top: 10px;
    right: 10px;
    background: none;
    border: none;
    color: {{ block.settings.text_color }};
    cursor: pointer;
    padding: 5px;
    opacity: 0.7;
    transition: opacity 0.3s ease;
    z-index: 3;
  }

  .ai-store-notice-close-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-store-notice-close-{{ ai_gen_id }} svg {
    width: 16px;
    height: 16px;
  }

  .ai-store-notice-{{ ai_gen_id }}.hidden {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .ai-store-notice-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical | times: 0.8 }}px {{ block.settings.padding_horizontal | times: 0.8 }}px;
      margin: {{ block.settings.margin_top | times: 0.8 }}px auto {{ block.settings.margin_bottom | times: 0.8 }}px;
    }

    .ai-store-notice-content-{{ ai_gen_id }} {
      flex-direction: column;
      text-align: center;
      gap: 10px;
    }

    .ai-store-notice-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
      min-width: auto;
    }

    .ai-store-notice-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<store-notice-{{ ai_gen_id }}
  class="ai-store-notice-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.show_close_button %}
    <button
      class="ai-store-notice-close-{{ ai_gen_id }}"
      aria-label="Close notice"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  {% endif %}

  <div class="ai-store-notice-content-{{ ai_gen_id }}">
    {% if block.settings.show_icon %}
      <div class="ai-store-notice-icon-{{ ai_gen_id }}">
        {% case block.settings.icon_type %}
          {% when 'warning' %}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
              <path d="M12 9v4"/>
              <path d="m12 17 .01 0"/>
            </svg>
          {% when 'info' %}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <path d="m12 16-4-4 4-4"/>
              <path d="M16 12H8"/>
            </svg>
          {% when 'sale' %}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/>
              <path d="M12 15v5"/>
              <path d="M8 17l4 4 4-4"/>
            </svg>
          {% when 'star' %}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/>
            </svg>
          {% when 'megaphone' %}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m3 11 18-5v12L3 14v-3z"/>
              <path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/>
            </svg>
        {% endcase %}
      </div>
    {% endif %}

    <div class="ai-store-notice-text-{{ ai_gen_id }}">
      {{ block.settings.notice_text }}
    </div>
  </div>
</store-notice-{{ ai_gen_id }}>

<script>
  (function() {
    class StoreNotice{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.closeButton = this.querySelector('.ai-store-notice-close-{{ ai_gen_id }}');
        this.setupEventListeners();
        this.checkStoredState();
      }

      setupEventListeners() {
        if (this.closeButton) {
          this.closeButton.addEventListener('click', () => {
            this.hideNotice();
          });
        }
      }

      hideNotice() {
        this.classList.add('hidden');
        if ({{ block.settings.remember_close | json }}) {
          localStorage.setItem('store-notice-{{ ai_gen_id }}-closed', 'true');
        }
      }

      checkStoredState() {
        if ({{ block.settings.remember_close | json }}) {
          const isClosed = localStorage.getItem('store-notice-{{ ai_gen_id }}-closed');
          if (isClosed === 'true') {
            this.classList.add('hidden');
          }
        }
      }
    }

    customElements.define('store-notice-{{ ai_gen_id }}', StoreNotice{{ ai_gen_id }});
  })();
</script>

