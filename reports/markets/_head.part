<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Mockers — International Setup</title>
<style>
  @page { size: A4; margin: 0; }
  * { box-sizing: border-box; }
  body {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    color: #1c2b33;
    font-size: 10pt;
    line-height: 1.55;
  }
  h1, h2, h3, h4 { font-family: 'Helvetica Neue', Arial, sans-serif; color: #0f2540; margin: 0 0 6px 0; }

  /* ---------- Cover page ---------- */
  .cover {
    height: 297mm;
    width: 210mm;
    position: relative;
    background: linear-gradient(160deg, #0d2b47 0%, #123a5e 45%, #17608c 100%);
    color: #ffffff;
    overflow: hidden;
    page-break-after: always;
  }
  .cover::after {
    content: "";
    position: absolute;
    right: -120px;
    bottom: -120px;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    background: radial-gradient(circle at center, rgba(41,182,246,0.35) 0%, rgba(41,182,246,0) 70%);
  }
  .cover-inner { position: relative; z-index: 2; padding: 26mm 20mm 0 20mm; height: 100%; }
  .cover-logo-wrap {
    background: #ffffff; border-radius: 14px; width: 90px; height: 90px;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 8px 24px rgba(0,0,0,0.25);
  }
  .cover-logo-wrap img { width: 66px; height: 66px; object-fit: contain; }
  .cover-agency { margin-top: 12px; font-size: 10pt; letter-spacing: 3px; color: #8fd3ff; text-transform: uppercase; font-weight: 600; }
  .cover-eyebrow { margin-top: 60px; font-size: 10.5pt; letter-spacing: 3px; color: #6fc3f0; text-transform: uppercase; font-weight: 700; }
  .cover-title { margin-top: 10px; font-size: 30pt; font-weight: 700; line-height: 1.2; max-width: 155mm; }
  .cover-subtitle { margin-top: 16px; font-size: 11.5pt; color: #cfe8fb; font-weight: 300; }
  .cover-divider { margin-top: 24px; width: 60px; height: 4px; background: linear-gradient(90deg, #29b6f6, #1e88e5); border-radius: 2px; }
  .cover-facts {
    margin-top: 34px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    max-width: 150mm;
  }
  .cover-fact {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 8px;
    padding: 10px 14px;
  }
  .cover-fact .k { font-size: 7.8pt; text-transform: uppercase; letter-spacing: 1px; color: #a9d6f2; margin-bottom: 3px; }
  .cover-fact .v { font-size: 11pt; font-weight: 700; color: #fff; }
  .cover-meta {
    position: absolute; bottom: 22mm; left: 20mm; right: 20mm;
    display: flex; justify-content: space-between;
    font-size: 9.5pt; color: #bcdff5;
    border-top: 1px solid rgba(255,255,255,0.25);
    padding-top: 12px;
  }
  .cover-meta strong { display: block; color: #ffffff; font-size: 10pt; margin-bottom: 2px; }

  /* ---------- Content flow ---------- */
  .doc { padding: 16mm 18mm 4mm 18mm; }
  .sec { margin-bottom: 20px; }
  .sec.fresh-page { page-break-before: always; }

  .doc-header {
    display: flex; align-items: center; justify-content: space-between;
    border-bottom: 2px solid #123a5e; padding-bottom: 8px; margin-bottom: 18px;
  }
  .doc-header .brand { display: flex; align-items: center; gap: 8px; }
  .doc-header .brand img { width: 22px; height: 22px; }
  .doc-header .brand span { font-weight: 700; color: #123a5e; font-size: 10.5pt; letter-spacing: 0.5px; }
  .doc-header .doc-name { font-size: 8.5pt; color: #6b7c87; text-transform: uppercase; letter-spacing: 1px; }

  .sec-title {
    display: flex; align-items: center; gap: 10px;
    margin: 0 0 10px 0;
    page-break-after: avoid;
    page-break-inside: avoid;
  }
  .sec-num {
    background: #123a5e; color: #fff; width: 26px; height: 26px; border-radius: 6px;
    display: flex; align-items: center; justify-content: center;
    font-size: 10.5pt; font-weight: 700; flex-shrink: 0;
  }
  .sec-title h2 { font-size: 13.5pt; margin: 0; }

  h3.sub {
    font-size: 10.6pt; color: #17608c; margin: 14px 0 6px 0;
    border-left: 3px solid #29b6f6; padding-left: 8px;
    page-break-after: avoid;
  }

  p { margin: 0 0 8px 0; }
  ul { margin: 4px 0 10px 0; padding-left: 20px; }
  li { margin-bottom: 4px; page-break-inside: avoid; }

  .lead { font-size: 10.2pt; color: #384852; }

  /* ---------- Callout boxes ---------- */
  .box {
    border-radius: 6px;
    padding: 10px 14px;
    margin: 8px 0 12px 0;
    font-size: 9.4pt;
    page-break-inside: avoid;
  }
  .box-info { background: #f2f8fc; border-left: 3px solid #17608c; }
  .box-warn { background: #fdf5ec; border-left: 3px solid #d18a2e; }
  .box-note { background: #f7f9fb; border: 1px solid #e6ebef; }
  .result-box { background: #eef7f0; border-left: 3px solid #1e8032; border-radius: 6px; padding: 10px 14px; margin: 8px 0 12px 0; font-size: 9.4pt; page-break-inside: avoid; }
  .result-box .label { display: block; font-weight: 700; color: #1e8032; font-size: 8.2pt; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 3px; }

  .link-box { background: #f7f9fb; border: 1px solid #e6ebef; border-radius: 6px; padding: 10px 14px; margin: 8px 0 12px 0; font-size: 9.2pt; page-break-inside: avoid; }
  .link-box .row { margin-bottom: 3px; }
  .link-box .label { color: #5b6b76; font-weight: 600; margin-right: 6px; }
  .link-box a { color: #17608c; }

  .tag-done, .tag-pending { font-size: 7pt; font-weight: 700; letter-spacing: 0.5px; padding: 2px 8px; border-radius: 10px; margin-left: 6px; vertical-align: middle; }
  .tag-done { background: #e7f5ea; color: #1e8032; }
  .tag-pending { background: #fdf1e3; color: #b25b13; }

  .shot { border: 1px solid #e6ebef; border-radius: 6px; padding: 6px; page-break-inside: avoid; margin: 8px 0; }
  .shot img { width: 100%; display: block; border-radius: 3px; }
  .shot .cap { font-size: 8pt; color: #7a8892; margin-top: 4px; text-align: center; }

  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 0 24px; }

  table.data { width: 100%; border-collapse: collapse; margin: 8px 0 14px 0; font-size: 9pt; page-break-inside: avoid; }
  table.data th { background: #123a5e; color: #fff; text-align: left; padding: 6px 9px; font-weight: 600; }
  table.data td { padding: 5px 9px; border-bottom: 1px solid #e6ebef; }
  table.data tr:nth-child(even) td { background: #f7f9fb; }

  table.summary { width: 100%; border-collapse: collapse; margin: 8px 0 14px 0; font-size: 9.3pt; }
  table.summary td { padding: 6px 9px; border-bottom: 1px dashed #e6ebef; vertical-align: top; }
  table.summary td.k { color: #5b6b76; width: 40%; font-weight: 600; }
  table.summary td.v { color: #1c2b33; font-weight: 600; }

  /* ---------- Investment highlight ---------- */
  .invest-box {
    background: linear-gradient(135deg, #0d2b47, #17608c);
    color: #fff;
    border-radius: 10px;
    padding: 20px 24px;
    text-align: center;
    margin: 10px 0 16px 0;
    page-break-inside: avoid;
  }
  .invest-box .lbl { font-size: 8.5pt; letter-spacing: 2px; text-transform: uppercase; color: #a9d6f2; }
  .invest-box .amt { font-size: 26pt; font-weight: 800; margin-top: 4px; }
  .invest-box .cur { font-size: 12pt; font-weight: 500; color: #cfe8fb; }

  /* ---------- Payment milestones ---------- */
  .milestones { display: flex; gap: 10px; margin: 10px 0 14px 0; }
  .milestone {
    flex: 1; background: #f7f9fb; border: 1px solid #e6ebef; border-radius: 8px;
    padding: 12px 12px; text-align: center; page-break-inside: avoid;
  }
  .milestone .pct { font-size: 17pt; font-weight: 800; color: #123a5e; }
  .milestone .amt { font-size: 9.5pt; color: #1e8032; font-weight: 700; margin-top: 2px; }
  .milestone .lbl { font-size: 8.2pt; color: #5b6b76; margin-top: 4px; line-height: 1.35; }

  /* ---------- Timeline phases ---------- */
  .phases { display: flex; flex-direction: column; gap: 10px; margin: 10px 0 14px 0; }
  .phase {
    border: 1px solid #e1e8ee; border-radius: 8px; overflow: hidden; page-break-inside: avoid;
  }
  .phase .phead {
    background: #f2f8fc; padding: 7px 12px; display: flex; justify-content: space-between; align-items: center;
  }
  .phase .phead .name { font-weight: 700; color: #123a5e; font-size: 9.8pt; }
  .phase .phead .dur { font-size: 8.2pt; color: #17608c; font-weight: 700; background: #e3f1fb; padding: 2px 9px; border-radius: 10px; }
  .phase .pbody { padding: 8px 12px; }
  .phase .pbody ul { margin: 4px 0; padding-left: 18px; }
  .phase .pbody li { font-size: 9pt; margin-bottom: 2px; }

  .timeline-total {
    display: flex; align-items: center; gap: 8px; justify-content: center;
    font-weight: 700; font-size: 10.5pt; color: #123a5e; margin: 12px 0;
  }
  .timeline-total .step { background: #eef4f9; border: 1px solid #d7e4ee; padding: 5px 14px; border-radius: 20px; }
  .timeline-total .arrow { color: #29b6f6; }
  .timeline-total .step.final { background: #123a5e; color: #fff; border-color: #123a5e; }

  /* ---------- Task list / checklist components ---------- */
  .progress-row { display: flex; gap: 14px; margin: 18px 0 14px 0; }
  .stat { flex: 1; background: #f7f9fb; border: 1px solid #e6ebef; border-radius: 8px; padding: 14px; text-align: center; }
  .stat .num { font-size: 22pt; font-weight: 800; color: #123a5e; }
  .stat.done .num { color: #1e8032; }
  .stat.pending .num { color: #d18a2e; }
  .stat .lbl { font-size: 8pt; text-transform: uppercase; letter-spacing: 1px; color: #7a8892; margin-top: 2px; }

  .bar-wrap { margin: 0 0 20px 0; }
  .bar-track { height: 8px; background: #e6ebef; border-radius: 4px; overflow: hidden; }
  .bar-fill { background: linear-gradient(90deg, #1e8032, #3fae57); height: 100%; }
  .bar-caption { display: flex; justify-content: space-between; font-size: 8pt; color: #7a8892; margin-top: 4px; }

  .sec-head { display: flex; align-items: center; gap: 8px; justify-content: space-between; border-bottom: 1px solid #e6ebef; padding-bottom: 6px; margin-bottom: 8px; }
  .sec-head .dot { width: 9px; height: 9px; border-radius: 50%; background: #29b6f6; flex-shrink: 0; }
  .sec-head h2 { font-size: 12pt; margin: 0; flex: 1; }
  .sec-head .count { font-size: 8.3pt; color: #7a8892; font-weight: 600; }

  .tasks { list-style: none; margin: 0; padding: 0; }
  .tasks li { display: flex; align-items: flex-start; gap: 10px; padding: 6px 0; border-bottom: 1px dashed #eef1f3; page-break-inside: avoid; }
  .task-box { width: 13px; height: 13px; border-radius: 3px; flex-shrink: 0; margin-top: 2px; }
  .task-box.done { border: 1.6px solid #1e8032; background: #1e8032; color: #fff; font-size: 9px; display: flex; align-items: center; justify-content: center; }
  .task-box.pending { border: 1.6px solid #9fb0ba; background: #fff; }
  .txt { flex: 1; }
  .scope { color: #17608c; }
  .badge { font-size: 7pt; font-weight: 700; letter-spacing: 0.5px; padding: 2px 8px; border-radius: 10px; flex-shrink: 0; }
  .badge.done { background: #e7f5ea; color: #1e8032; }
  .badge.pending { background: #fdf1e3; color: #b25b13; }

  /* ---------- Repeating footer (position:fixed repeats on every printed page) ---------- */
  .page-wrap { width: 100%; border-collapse: collapse; }
  .page-wrap > tbody > tr > td, .page-wrap > tfoot > tr > td { padding: 0; border: 0; }
  .page-footer {
    margin: 0 18mm 7mm 18mm;
    font-size: 7.5pt; color: #9aa8b1; display: flex; justify-content: space-between;
    border-top: 1px solid #e6ebef; padding-top: 6px;
  }
</style>
